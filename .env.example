# Backend — DATABASE_URL points at Neon (no local Postgres container).
# asyncpg uses ssl=require (NOT sslmode) and rejects channel_binding
DATABASE_URL=postgresql+asyncpg://user:pw@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?ssl=require
JWT_SECRET=change-me-in-prod
ENV=dev

# OTP (dev echoes the code in the API response; set false in prod)
OTP_DEV_ECHO=true

# Dev demo: true = tokenless requests act as a seeded verified demo retailer
# (no login needed). MUST be false in real production.
DEV_NO_AUTH=false

# Admin seed — this phone logs in via OTP and gets the ADMIN role
ADMIN_PHONE=+919999999999

# Payments: stub (instant, dev) or razorpay
PAYMENTS_PROVIDER=stub
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

PLATFORM_FEE_PCT=0.05
ACCEPT_WINDOW_HOURS=12
PAYMENT_WINDOW_MIN=15
DISPUTE_WINDOW_HOURS=48

CORS_ORIGINS=http://localhost:5173,http://localhost

# ---------------------------------------------------------------------------
# Production — two env files live next to ~/krishilink/docker-compose.yml:
#
#   .env    — written by the CI deploy step from GitHub secrets
#             (JWT_SECRET, ENV=prod, OTP_DEV_ECHO=false, ADMIN_PHONE,
#              PAYMENTS_PROVIDER, CORS_ORIGINS, fee/window knobs)
#
#   db.env  — created ONCE by you on the host; never touched by CI or git:
#               DATABASE_URL=postgresql+asyncpg://user:pw@ep-xxx-pooler.<region>.aws.neon.tech/<db>?ssl=require
#
# Compose also interpolates image names from:
#   DOCKERHUB_USERNAME=<your-dockerhub-user>
#   TAG=latest
